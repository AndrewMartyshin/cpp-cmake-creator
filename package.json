{
  "name": "cppcmakecreator",
  "displayName": "new_project_creator",
  "description": "Creates C++ CMake projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewMartyshin/cpp-cmake-creator.git"
  },
  "publisher": "AndrewMartyshin", 
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.createCppCmakeProject",
        "title": "Create C++ CMake Project",
        "category": "C++ Tools",
        "icon": "$(new-folder)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.createCppCmakeProject"
        }
      ],
      "explorer/context": [
        {
          "command": "extension.createCppCmakeProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
